**/macos/Pods/
**/ios/Podfile.lock
**/macos/Podfile.lock

# WorkBuddy 项目数据（非源码）
.workbuddy/

# 本地凭据（不入库）
local_*.env

# 上游同步辅助：本地工具链镜像与脚本（不入库，可按需重建）
/.tooling/
/.upstream/
/tools/_flutter_sdk/
tools/fetch_upstream.py
tools/parse_analyze.py
tools/diff_strings.py
analyze_*.log
build_runner.log

# 本地发布构建产物
/dist/

# libtorrent_flutter 安卓原生库本地构建工作区（源码下载与中间产物）
third_party/libtorrent_flutter/build_android/

